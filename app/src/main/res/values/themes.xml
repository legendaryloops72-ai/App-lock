<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar" />

    <!-- Splash Screen Theme (Android 12+ official SplashScreen API & backward compatibility) -->
