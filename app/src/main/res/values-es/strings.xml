    <string name="onboarding_title_2">Selfie y registro de intrusos</string>
    <string name="onboarding_desc_2">¡Detecta a los intrusos automáticamente! Si alguien introduce un PIN o patrón incorrecto, App Lock registra al intruso.</string>
    <string name="onboarding_title_3">Desbloqueo biométrico rápido</string>
    <string name="onboarding_desc_3">Desbloquea tus aplicaciones protegidas al instante mediante huella digital o reconocimiento facial sin fricción.</string>
